# ─────────────────────────────────────────
# NODE ENVIRONMENT
# ─────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
API_VERSION=v1

# ─────────────────────────────────────────
# DATABASE — Local Docker MongoDB
# ─────────────────────────────────────────
MONGODB_URI=mongodb://admin:devpassword@localhost:27017/consultancy_dev?authSource=admin
MONGODB_DB_NAME=consultancy_dev

# ─────────────────────────────────────────
# REDIS — Local Docker Redis
# ─────────────────────────────────────────
REDIS_URL=redis://:devredispassword@localhost:6379
REDIS_TLS=false

# ─────────────────────────────────────────
# SESSIONS / COOKIES
# ─────────────────────────────────────────
SESSION_SECRET=change_me_to_random_64_char_hex_string_for_development_only
COOKIE_NAME=consultancy_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_MAX_AGE_MS=604800000

# ─────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────
BCRYPT_ROUNDS=12
JWT_SECRET=change_me_to_random_64_char_hex_string_for_jwt_signing
JWT_QR_EXPIRY=90d
MFA_ISSUER=JapanConsultancy
ENCRYPTION_KEY=Y2hhbmdlX21lXzMyX2J5dGVzX2Jhc2U2NF9rZXk=

# ─────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ─────────────────────────────────────────
# CLOUDFLARE R2 (Documents)
# ─────────────────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=consultancy-documents
R2_PUBLIC_URL=https://your-hash.r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY_SECONDS=300

# ─────────────────────────────────────────
# CLOUDINARY (Profile Photos Only)
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=consultancy/profile-photos

# ─────────────────────────────────────────
# RESEND (Email)
# ─────────────────────────────────────────
RESEND_API_KEY=re_your_key
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=Japan Consultancy
EMAIL_REPLY_TO=support@yourdomain.com

# ─────────────────────────────────────────
# LEAD INTAKE API KEY
# ─────────────────────────────────────────
LEAD_INTAKE_API_KEY=change_me_to_random_64_char_hex_string_for_intake

# ─────────────────────────────────────────
# ORGANIZATION
# ─────────────────────────────────────────
ORG_NAME=Your Consultancy Name
ORG_TIMEZONE=Asia/Kathmandu
ORG_CURRENCY=NPR
ORG_LOCALE=en-NP
DEFAULT_COUNTRY=Nepal

# ─────────────────────────────────────────
# SUPER ADMIN BOOTSTRAP
# ─────────────────────────────────────────
SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_PASSWORD=SuperAdmin@12345
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# ─────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ─────────────────────────────────────────
# QUEUE
# ─────────────────────────────────────────
QUEUE_CONCURRENCY_NOTIFICATION=5
QUEUE_CONCURRENCY_EMAIL=3
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_BACKOFF_MS=5000

# ─────────────────────────────────────────
# CORS
# ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000